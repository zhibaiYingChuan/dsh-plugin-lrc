{
  "name": "dsh-plugin-lrc",
  "version": "0.1.0",
  "description": "把 LRC 的结构化记忆接进 DeepSeek Harness 的上下文压缩流程",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "smoke": "node scripts/smoke.ts",
    "e2e": "node scripts/e2e-offload.ts",
    "e2e:runtime": "node scripts/e2e-runtime.ts",
    "test": "node scripts/smoke.ts && node scripts/e2e-offload.ts && node scripts/e2e-runtime.ts"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "context",
    "compaction"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-compaction-basic": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
