{
  "name": "dsh-plugin-lrc",
  "version": "0.2.1",
  "description": "把 LRC 的结构化长期记忆接进 DeepSeek Harness：边聊边沉淀、按需召回、可纠错，让上下文不再需要频繁压缩",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/index.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhibaiYingChuan/dsh-plugin-lrc.git"
  },
  "homepage": "https://github.com/zhibaiYingChuan/dsh-plugin-lrc#readme",
  "bugs": {
    "url": "https://github.com/zhibaiYingChuan/dsh-plugin-lrc/issues"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --charset=utf8 --external:@deepseek-ai/* --outfile=dist/index.js",
    "smoke": "node scripts/smoke.ts",
    "e2e": "node scripts/e2e-offload.ts",
    "e2e:runtime": "node scripts/e2e-runtime.ts",
    "e2e:host": "node scripts/e2e-host-payload.ts",
    "e2e:filter": "node scripts/e2e-filter.ts",
    "e2e:trim": "node scripts/e2e-trim.ts",
    "e2e:handoff": "node scripts/e2e-handoff.ts",
    "e2e:apply": "node --import ./scripts/register-loader.mjs scripts/e2e-apply.ts",
    "e2e:governor": "node scripts/e2e-governor.ts",
    "e2e:budget": "node scripts/e2e-budget.ts",
    "e2e:turn": "node --import ./scripts/register-loader.mjs scripts/e2e-turn.ts",
    "e2e:invariant": "node scripts/e2e-invariant.ts",
    "e2e:profile": "node scripts/e2e-profile.ts",
    "test": "node scripts/smoke.ts && node scripts/e2e-offload.ts && node scripts/e2e-runtime.ts && node scripts/e2e-host-payload.ts && node scripts/e2e-filter.ts && node scripts/e2e-trim.ts && node scripts/e2e-host-surface.ts && node scripts/e2e-handoff.ts && node scripts/e2e-governor.ts && node scripts/e2e-budget.ts && node scripts/e2e-profile.ts && node scripts/e2e-invariant.ts && node --import ./scripts/register-loader.mjs scripts/e2e-apply.ts && node --import ./scripts/register-loader.mjs scripts/e2e-turn.ts"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "context",
    "compaction"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
